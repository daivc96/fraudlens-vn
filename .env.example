# FraudLens projection API
FRAUDLENS_DB_PATH=/data/fraudlens.db
FRAUDLENS_SYNC_TOKEN=replace-with-a-long-random-value
FRAUDLENS_ALLOWED_ORIGINS=http://localhost:4173,https://fraudlens-vn.tactactac.chatgpt.site

# Official MISP Docker is exposed locally on 10443 by scripts/misp-local.sh.
# Inside the FraudLens API container, Docker Desktop resolves this hostname.
MISP_URL=https://host.docker.internal:10443
MISP_API_KEY=replace-with-the-api-key-from-misp
MISP_VERIFY_TLS=false
MISP_PUBLISH_TAG=fraudlens:publish=true
